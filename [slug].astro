---
import { getCollection } from 'astro:content';
import V from '../../../views/OfferingDetail.astro';
import { slugOf } from '../../../i18n/content';

export async function getStaticPaths() {
  const all = await getCollection('services', (e) => !e.data.draft);
  const other = 'en' === 'lt' ? 'en' : 'lt';
  return all
    .filter((e) => e.id.startsWith('en/'))
    .map((entry) => ({
      params: { slug: slugOf(entry.id) },
      props: { entry, hasTranslation: all.some((e) => e.id === `${other}/${slugOf(entry.id)}`) },
    }));
}
const { entry, hasTranslation } = Astro.props;
---
<V lang="en" kind="services" entry={entry} hasTranslation={hasTranslation} />
