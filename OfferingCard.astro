---
import Icon from './Icon.astro';
interface Props { title: string; summary: string; icon: string; href: string; more: string }
const { title, summary, icon, href, more } = Astro.props;
---
<article class="card">
  <div class="icon"><Icon name={icon} /></div>
  <h3>{title}</h3>
  <p>{summary}</p>
  <a class="card-link" href={href} aria-label={`${more}: ${title}`}>{more}</a>
</article>
