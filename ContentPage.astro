---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { routes, t, alt, type Lang } from '../i18n/ui';
import { getPage } from '../i18n/content';
interface Props { lang: Lang; name: 'about' | 'privacy' }
const { lang, name } = Astro.props;
const tr = t(lang);
const page = await getPage(lang, name);
const { Content } = await render(page);
const d = page.data;
---
<Base lang={lang} title={d.seo_title || d.title} description={d.seo_description || d.lead} alternates={alt(name)}>
  <section class="hero page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={routes.home[lang]}>{tr('nav.home')}</a> / {d.title}</nav>
      <h1>{d.title}</h1>
      {d.lead && <p>{d.lead}</p>}
    </div>
  </section>
  <section class="section">
    <div class="container"><article class="prose"><Content /></article></div>
  </section>
  {name === 'about' && <CtaBand lang={lang} />}
</Base>
