---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import settings from '../data/settings.json';
import { routes, t, alt, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
const hours = lang === 'lt' ? settings.working_hours_lt : settings.working_hours_en;
const formName = `contact-${lang}`;
---
<Base lang={lang} title={tr('contact.title')} description={tr('contact.lead')} alternates={alt('contact')}>
  <section class="hero page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={routes.home[lang]}>{tr('nav.home')}</a> / {tr('contact.title')}</nav>
      <h1>{tr('contact.title')}</h1>
      <p>{tr('contact.lead')}</p>
    </div>
  </section>
  <section class="section">
    <div class="container contact-grid">
      <div>
        <ul class="contact-list">
          <li><span class="icon"><Icon name="mail" size={20} /></span><div><small>{tr('contact.email')}</small><a href={`mailto:${settings.email}`}>{settings.email}</a></div></li>
          <li><span class="icon"><Icon name="phone" size={20} /></span><div><small>{tr('contact.phone')}</small><a href={`tel:${settings.phone.replace(/\s/g, '')}`}>{settings.phone}</a></div></li>
          <li><span class="icon"><Icon name="pin" size={20} /></span><div><small>{tr('contact.address')}</small>{settings.address}<br />{settings.map_url && <a href={settings.map_url} target="_blank" rel="noopener noreferrer">{tr('contact.map')}</a>}</div></li>
          <li><span class="icon"><Icon name="clock" size={20} /></span><div><small>{tr('contact.hours')}</small>{hours}</div></li>
          <li><span class="icon"><Icon name="doc" size={20} /></span><div><small>{tr('contact.requisites')}</small>{settings.company_name}<br />{tr('contact.company_code')}: {settings.company_code}<br />{tr('contact.vat_code')}: {settings.vat_code}</div></li>
        </ul>
      </div>
      <div class="form-card">
        <h2>{tr('form.title')}</h2>
        <!-- Netlify Forms: apsauga nuo šlamšto (honeypot) + serverio pusės apdorojimas be jokio backend kodo -->
        <form name={formName} method="POST" action={routes.thanks[lang]} data-netlify="true" netlify-honeypot="company_website">
          <input type="hidden" name="form-name" value={formName} />
          <p class="hp" aria-hidden="true"><label>Website <input name="company_website" tabindex="-1" autocomplete="off" /></label></p>
          <div class="form-grid">
            <div><label for="f-name">{tr('form.name')} *</label><input id="f-name" name="name" required maxlength="120" autocomplete="name" /></div>
            <div><label for="f-company">{tr('form.company')}</label><input id="f-company" name="company" maxlength="120" autocomplete="organization" /></div>
            <div><label for="f-email">{tr('form.email')} *</label><input id="f-email" name="email" type="email" required maxlength="160" autocomplete="email" /></div>
            <div><label for="f-phone">{tr('form.phone')}</label><input id="f-phone" name="phone" type="tel" maxlength="40" autocomplete="tel" pattern="[0-9+()\s\-]{6,40}" /></div>
            <div class="full"><label for="f-msg">{tr('form.message')} *</label><textarea id="f-msg" name="message" required maxlength="4000"></textarea></div>
            <div class="full"><label class="checkbox"><input type="checkbox" name="consent" required /> <span>{tr('form.consent')} <a href={routes.privacy[lang]}>{tr('form.consent_link')}</a>.</span></label></div>
            <div class="full"><button class="btn btn--primary" type="submit">{tr('form.submit')}</button></div>
          </div>
        </form>
      </div>
    </div>
  </section>
</Base>
