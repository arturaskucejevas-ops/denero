---
// Pradinis puslapis – DENERO Apskaita pristatymas
import Base from '../layouts/Base.astro';
import OfferingCard from '../components/OfferingCard.astro';
import Testimonials from '../components/Testimonials.astro';
import Icon from '../components/Icon.astro';
import ap from '../data/apskaita.json';
import settings from '../data/settings.json';
import { routes, t, alt, detailPath, type Lang } from '../i18n/ui';
import { getOfferings, slugOf } from '../i18n/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const a = ap[lang];
const tr = t(lang);
const login = ap.login_url;
const solutions = (await getOfferings('solutions', lang)).filter((s) => !s.id.endsWith('/denero-apskaita'));
const site = Astro.site!;
const paid = a.plans.filter((p: any) => p.price_m);
const homeUrl = new URL(routes.home[lang], site).href;
const appLd = {
  '@context': 'https://schema.org', '@type': 'SoftwareApplication',
  name: 'DENERO Apskaita', alternateName: lang === 'lt' ? 'DENERO apskaitos programa' : 'DENERO accounting software',
  applicationCategory: 'BusinessApplication', applicationSubCategory: lang === 'lt' ? 'Apskaitos programa' : 'Accounting software',
  operatingSystem: 'Web', inLanguage: ['lt', 'en'], countriesSupported: 'LT',
  description: a.seo_description, url: homeUrl, installUrl: login,
  featureList: a.features.map((f: any) => f.title).join(', '),
  keywords: settings.seo[lang].keywords,
  screenshot: new URL('/og-image.png', site).href,
  publisher: { '@type': 'Organization', name: settings.company_name, url: site.href },
  offers: {
    '@type': 'AggregateOffer', priceCurrency: 'EUR', offerCount: paid.length,
    lowPrice: Math.min(...paid.map((p: any) => p.price_m)), highPrice: Math.max(...paid.map((p: any) => p.price_m)),
    offers: paid.map((p: any) => ({
      '@type': 'Offer', name: `DENERO Apskaita ${p.name}`, price: p.price_m, priceCurrency: 'EUR',
      url: `${homeUrl}#planai`, availability: 'https://schema.org/InStock',
      description: `${p.desc}. ${p.users} ${lang === 'lt' ? 'vartotojai' : 'users'}. ${p.features.join(', ')}.`,
      priceSpecification: [
        { '@type': 'UnitPriceSpecification', price: p.price_m, priceCurrency: 'EUR', valueAddedTaxIncluded: false, billingDuration: 'P1M', unitCode: 'MON' },
        { '@type': 'UnitPriceSpecification', price: p.price_y, priceCurrency: 'EUR', valueAddedTaxIncluded: false, billingDuration: 'P1Y', unitCode: 'ANN' },
      ],
    })),
  },
};
const faqLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: a.faq.map((f: any) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const eur = (n: number) => {
  const v = Math.round(n * 100) / 100;
  const txt = v.toLocaleString(lang === 'lt' ? 'lt-LT' : 'en-GB', { minimumFractionDigits: Number.isInteger(v) ? 0 : 2, maximumFractionDigits: 2 });
  return lang === 'lt' ? `${txt} €` : `€${txt}`;
};
const save = (p: any) => (p.price_m && p.price_y ? Math.round((1 - p.price_y / (12 * p.price_m)) * 100) : 0);
const maxSave = Math.max(...a.plans.map((p: any) => save(p)));
const months = lang === 'lt' ? ['Sau', 'Vas', 'Kov', 'Bal', 'Geg', 'Bir'] : ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'];
---
<Base lang={lang} title={a.seo_title} description={a.seo_description} alternates={alt('home')} jsonLd={[appLd, faqLd]}>
  <section class="hero hero--app">
    <div class="container hero-split">
      <div>
        <span class="eyebrow">{a.eyebrow}</span>
        <h1>{a.title}</h1>
        <p>{a.text}</p>
        <div class="hero-actions">
          <a class="btn btn--primary btn--lg" href={login} data-umami-event="Prisijungti (hero)">
            <Icon name="lock" size={18} /> {a.login}
          </a>
          <a class="btn btn--ghost btn--lg" href="#planai">{a.see_plans}</a>
        </div>
        <ul class="hero-trust">{a.trust.map((x) => <li>{x}</li>)}</ul>
      </div>

      <!-- Sistemos vaizdo maketas (iliustracija) -->
      <div class="mock" aria-hidden="true">
        <div class="mock-bar"><span></span><span></span><span></span><em>apskaita.denero.eu</em></div>
        <div class="mock-body">
          <aside class="mock-side">
            <img src="/brand/denero-logo-light.svg" alt="" width="70" height="29" />
            <i class="on"></i><i></i><i></i><i></i><i></i>
          </aside>
          <div class="mock-main">
            <div class="mock-kpis">
              <div><small>{lang === 'lt' ? 'Pajamos' : 'Revenue'}</small><b>48 250 €</b><u class="up">+12%</u></div>
              <div><small>{lang === 'lt' ? 'Išlaidos' : 'Expenses'}</small><b>31 480 €</b><u>−4%</u></div>
              <div><small>{lang === 'lt' ? 'Pelnas' : 'Profit'}</small><b>16 770 €</b><u class="up">+21%</u></div>
            </div>
            <div class="mock-chart">
              {months.map((m, i) => <div class={`col c${i + 1}`}><span class="b1"></span><span class="b2"></span><small>{m}</small></div>)}
            </div>
            <div class="mock-rows">
              <div><span>{lang === 'lt' ? 'Sąskaita' : 'Invoice'} DEN-0142</span><b class="ok">{lang === 'lt' ? 'Apmokėta' : 'Paid'}</b></div>
              <div><span>{lang === 'lt' ? 'Sąskaita' : 'Invoice'} DEN-0141</span><b class="wait">{lang === 'lt' ? 'Laukiama' : 'Pending'}</b></div>
              <div><span>{lang === 'lt' ? 'Sąskaita' : 'Invoice'} DEN-0140</span><b class="ok">{lang === 'lt' ? 'Apmokėta' : 'Paid'}</b></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>{a.features_title}</h2>
        <p>{a.features_text}</p>
      </div>
      <div class="feature-grid feature-grid--3">
        {a.features.map((f) => (
          <div class="feature feature--icon">
            <div class="icon"><Icon name={f.icon} /></div>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head"><h2>{a.steps_title}</h2></div>
      <ol class="steps steps--row">{a.steps.map((s) => <li><strong>{s.title}</strong> {s.text}</li>)}</ol>
    </div>
  </section>

  <section class="section pricing" id="planai" aria-labelledby="plans-title">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">DENERO Apskaita</span>
        <h2 id="plans-title">{a.plans_title}</h2>
        <p>{a.plans_text}</p>
      </div>
      <div class="billing" role="group" aria-label={`${a.billing_month} / ${a.billing_year}`}>
        <button type="button" class="billing-opt is-on" data-billing="m" aria-pressed="true">{a.billing_month}</button>
        <button type="button" class="billing-opt" data-billing="y" aria-pressed="false">{a.billing_year} <em>−{maxSave} %</em></button>
      </div>
      <div class="plans">
        {a.plans.map((p) => (
          <article class={`plan ${p.popular ? 'plan--popular' : ''} ${p.individual ? 'plan--custom' : ''} ${p.placeholder ? 'plan--draft' : ''}`}>
            {p.popular && <span class="plan-badge">{a.popular}</span>}
            <h3>{p.name}</h3>
            <p class="plan-desc">{p.desc}</p>
            {p.individual ? (
              <>
                <div class="plan-price"><strong>{p.price}</strong></div>
                {p.intro && <p class="plan-intro">{p.intro}</p>}
              </>
            ) : (
              <>
                <div class="plan-price">
                  <strong class="pm">{eur(p.price_m)}</strong><span class="pm">{a.per_m}</span>
                  <strong class="py">{eur(p.price_y)}</strong><span class="py">{a.per_y}</span>
                </div>
                <p class="plan-alt">
                  <span class="pm">{a.alt_m.replace('{y}', eur(p.price_y))}{save(p) > 0 && <b> · {a.billing_save} {save(p)}&nbsp;%</b>}</span>
                  <span class="py">{a.alt_y.replace('{m}', eur(p.price_y / 12))}</span>
                </p>
                {p.users && (
                  <div class="plan-users">
                    <Icon name="users" size={18} />
                    <div>
                      <strong>{(p.users === 1 ? a.users_incl_1 : a.users_incl).replace('{n}', String(p.users))}</strong>
                      {p.extra_user_m && <span class="pm">{a.extra_user_m.replace('{p}', eur(p.extra_user_m))}</span>}
                      {p.extra_user_y && <span class="py">{a.extra_user_y.replace('{p}', eur(p.extra_user_y))}</span>}
                    </div>
                  </div>
                )}
              </>
            )}
            <p class="plan-label">{a.features_label}</p>
            <ul class="plan-features">
              {p.features.map((f) => <li>{f}</li>)}
              {p.plus && <li class="plus">{p.plus}</li>}
            </ul>
            {p.addons && (
              <details class="plan-addons">
                <summary>{a.addons_toggle} <span class="cnt">{p.addons.length}</span></summary>
                <ul>
                  {p.addons.map((x) => (
                    <li>
                      <div class="pa-row">
                        <span class="pa-name">{x.name}{x.note && <small>{x.note}</small>}</span>
                        {!x.tiers && (
                          <span class="pa-price"><b class="pm">{eur(x.m)}</b><b class="py">{eur(x.y)}</b><small class="pm">{a.per_m_short}</small><small class="py">{a.per_y_short}</small></span>
                        )}
                      </div>
                      {x.tiers && (
                        <ul class="pa-tiers">
                          {x.tiers.map((t) => (
                            <li><span>{t.label}</span><span class="pa-price"><b class="pm">{eur(t.m)}</b><b class="py">{eur(t.y)}</b><small class="pm">{a.per_m_short}</small><small class="py">{a.per_y_short}</small></span></li>
                          ))}
                        </ul>
                      )}
                    </li>
                  ))}
                </ul>
              </details>
            )}
            <a class={`btn ${p.popular || p.individual ? 'btn--primary' : 'btn--outline'} plan-cta`}
               href={p.individual ? routes.contact[lang] : login}
               data-umami-event={`Planas: ${p.name}`}>{p.cta}</a>
          </article>
        ))}
      </div>

      <p class="plans-note">{a.plans_note}</p>
    </div>
  </section>

  <Testimonials lang={lang} soft />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>{a.more_title}</h2>
        <p>{a.more_text}</p>
      </div>
      <div class="grid">
        {solutions.map((s) => (
          <OfferingCard title={s.data.title} summary={s.data.card_summary || s.data.summary} soon={s.data.coming_soon} soonLabel={tr('solution.coming_soon')} price={s.data.price} icon={s.data.icon}
            href={detailPath('solutions', lang, slugOf(s.id))} more={tr('common.more')} />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="faq-title">
    <div class="container">
      <section class="faq faq--wide">
        <h2 id="faq-title">{a.faq_title}</h2>
        {a.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </section>
    </div>
  </section>

  <section class="section section--flush">
    <div class="container">
      <div class="cta-band">
        <div><h2>{a.cta_title}</h2><p>{a.cta_text}</p></div>
        <div class="hero-actions">
          <a class="btn btn--primary" href={routes.contact[lang]}>{a.cta_button}</a>
          <a class="btn btn--ghost" href={login}>{a.login}</a>
        </div>
      </div>
    </div>
  </section>
</Base>
