---
import settings from '../data/settings.json';
interface Props { href: string }
const { href } = Astro.props;
---
<a class="logo" href={href}>
  {settings.logo
    ? <img src={settings.logo} alt={settings.company_name} width="140" height="36" />
    : <><span class="logo-mark" aria-hidden="true">{settings.short_name.charAt(0)}</span><span>{settings.short_name}</span></>}
</a>
