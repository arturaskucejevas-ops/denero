---
// Pokalbio burbulas apačioje dešinėje: greita žinutė į info@denero.eu (Web3Forms).
import settings from '../data/settings.json';
import { routes, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const w3f = settings.web3forms_key;
const lt = lang === 'lt';
const T = lt ? {
  open: 'Parašykite mums', close: 'Uždaryti', title: 'Parašykite mums',
  sub: 'Atsakysime kuo greičiau – dažniausiai tą pačią darbo dieną.',
  name: 'Vardas', email: 'El. paštas', msg: 'Jūsų klausimas', send: 'Siųsti',
  consent: 'Sutinku su', policy: 'privatumo politika',
  done: 'Ačiū! Žinutė išsiųsta.', doneSub: 'Atsakysime į nurodytą el. paštą.',
  subject: 'Žinutė iš pokalbio lango – denero.eu',
} : {
  open: 'Send us a message', close: 'Close', title: 'Send us a message',
  sub: 'We will reply as soon as possible – usually the same business day.',
  name: 'Name', email: 'Email', msg: 'Your question', send: 'Send',
  consent: 'I agree to the', policy: 'privacy policy',
  done: 'Thank you! Message sent.', doneSub: 'We will reply to the email you provided.',
  subject: 'Message from chat widget – denero.eu (EN)',
};
---
{w3f && (
  <div class="chat" id="chat">
    <div class="chat-panel" id="chat-panel" role="dialog" aria-modal="false" aria-labelledby="chat-title" hidden>
      <div class="chat-head">
        <img src="/brand/denero-logo-light.svg" alt="DENERO" width="88" height="36" />
        <div>
          <strong id="chat-title">{T.title}</strong>
          <span>{T.sub}</span>
        </div>
        <button type="button" class="chat-x" data-chat-close aria-label={T.close}>×</button>
      </div>
      <form class="chat-form" method="POST" action="https://api.web3forms.com/submit" data-inline="chat-done">
        <input type="hidden" name="access_key" value={w3f} />
        <input type="hidden" name="subject" value={T.subject} />
        <input type="hidden" name="from_name" value="Denero svetainė – pokalbis" />
        <input type="hidden" name="redirect" value={new URL(routes.thanks[lang], Astro.site).href} />
        <p class="hp" aria-hidden="true"><label>Botcheck <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" /></label></p>
        <label for="chat-msg">{T.msg}</label>
        <textarea id="chat-msg" name="message" required maxlength="2000" rows="3"></textarea>
        <div class="chat-row">
          <div><label for="chat-name">{T.name}</label><input id="chat-name" name="name" maxlength="120" autocomplete="name" /></div>
          <div><label for="chat-email">{T.email} *</label><input id="chat-email" name="email" type="email" required maxlength="160" autocomplete="email" /></div>
        </div>
        <label class="checkbox chat-consent"><input type="checkbox" name="consent" required /> <span>{T.consent} <a href={routes.privacy[lang]}>{T.policy}</a>.</span></label>
        <button class="btn btn--primary chat-send" type="submit" data-umami-event="Pokalbio žinutė">{T.send}</button>
        <p class="form-status" role="alert" aria-live="polite"></p>
      </form>
      <div class="chat-done" id="chat-done" tabindex="-1" hidden>
        <div class="chat-check" aria-hidden="true">✓</div>
        <strong>{T.done}</strong>
        <span>{T.doneSub}</span>
      </div>
    </div>
    <button type="button" class="chat-btn" id="chat-btn" aria-controls="chat-panel" aria-expanded="false" aria-label={T.open} data-umami-event="Pokalbio langas atidarytas">
      <svg class="chat-ico-open" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-4.9A8 8 0 1 1 21 12z"/><path d="M8.5 11.5h.01M12 11.5h.01M15.5 11.5h.01" stroke-width="2.6"/></svg>
      <svg class="chat-ico-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>
)}
