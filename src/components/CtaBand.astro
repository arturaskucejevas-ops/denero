---
import home from '../data/home.json';
import { routes, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const h = home[lang];
---
<section class="section section--flush">
  <div class="container">
    <div class="cta-band">
      <div><h2>{h.cta_title}</h2><p>{h.cta_text}</p></div>
      <a class="btn btn--primary" href={routes.contact[lang]}>{h.cta_button}</a>
    </div>
  </div>
</section>
