---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { routes, t, type Lang, type Alternates } from '../i18n/ui';
interface Props { lang: Lang; alternates: Alternates }
const { lang, alternates } = Astro.props;
const tr = t(lang);
const path = Astro.url.pathname;
const items = [
  { href: routes.services[lang], label: tr('nav.services') },
  { href: routes.solutions[lang], label: tr('nav.solutions') },
  { href: routes.about[lang], label: tr('nav.about') },
  { href: routes.contact[lang], label: tr('nav.contact') },
];
const other: Lang = lang === 'lt' ? 'en' : 'lt';
---
<a class="skip-link" href="#main">{tr('nav.skip')}</a>
<header class="site-header">
  <div class="container">
    <Logo href={routes.home[lang]} />
    <nav class="nav" id="site-nav" aria-label={tr('nav.menu')}>
      {items.map((i) => (
        <a href={i.href} aria-current={path.startsWith(i.href) ? 'page' : undefined}>{i.label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <div class="lang-switch">
        {lang === 'lt' ? <span aria-current="true">LT</span> : <a href={alternates.lt} hreflang="lt" lang="lt" title={tr('lang.switch')}>LT</a>}
        {lang === 'en' ? <span aria-current="true">EN</span> : <a href={alternates.en} hreflang="en" lang="en" title={tr('lang.switch')}>EN</a>}
      </div>
      <a class="btn btn--primary header-cta" href={routes.contact[lang]}>{tr('nav.contact')}</a>
      <button class="menu-toggle" type="button" aria-controls="site-nav" aria-expanded="false" aria-label={tr('nav.menu')}>
        <Icon name="menu" />
      </button>
    </div>
  </div>
</header>
